# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# App URL — used server-side to build absolute short URLs and auth redirects.
# MUST be set in production, or server-rendered short URLs fall back to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Short domain shown in the UI for generated links (e.g. tws.bio)
NEXT_PUBLIC_SHORT_DOMAIN=localhost:3000

# --- Measurement -------------------------------------------------------------
# Note: there is deliberately no client-side GTM container here. tws.bio is a
# private link tool, not an audience source, so its app pages load no tag
# manager, no analytics and no session recorder. Only short-link CLICKS are
# measured, server-side, via the two vars below.

# GTM server container endpoint. The /[shortCode] redirect posts each click
# here, because a 302 has no page on which to run the web container.
# Leave unset to disable server-side click tracking.
SGTM_ENDPOINT=https://sgtm.example.com

# GA4 destination for those clicks. This is NOT duplicated GTM config: during a
# redirect there is no GTM running to read it from, this app IS the tag speaking
# GA4's Measurement Protocol. The server container's GA4 client rejects a hit
# with no `tid` (HTTP 400), and its forwarding tag sets no measurement ID of its
# own, so this value decides which property the click lands in.
# Must be a GA4 web measurement ID (G-...), never a GTM container ID.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Salt for the derived, cookieless GA4 client ID. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Rotating it resets returning-visitor counts, so treat it as long lived.
SGTM_CID_SALT=

# Set to `off` to stop stamping default utm_source/medium/campaign on short
# links that carry no campaign of their own. Any other value leaves it on.
SHORTLINK_AUTOTAG=on
